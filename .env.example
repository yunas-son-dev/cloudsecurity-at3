# Copy to .env for local development. Placeholders only - never commit real values.

# local | aws  (defaults to local when no AWS settings are present)
APP_ENV=local

# Flask session signing key. In AWS prefer APP_SECRET_NAME instead.
SECRET_KEY=change-me-to-a-long-random-string
# APP_SECRET_NAME=namawin/app-secret

# AWS settings (leave unset for local development)
# AWS_REGION=ap-southeast-2
# DB_SECRET_NAME=namawin/rds-credentials
# RDS_CA_BUNDLE=/var/app/current/certs/global-bundle.pem
# S3_BUCKET=example-namawin-documents
# KMS_KEY_ID=arn:aws:kms:ap-southeast-2:111122223333:key/00000000-0000-0000-0000-000000000000
# COGNITO_USER_POOL_ID=ap-southeast-2_EXAMPLE
# COGNITO_APP_CLIENT_ID=exampleclientid1234567890

# Set to false ONLY for local development or the first deployment before Cognito exists.
AUTH_REQUIRED=false

# Transaction rule thresholds
TXN_AMOUNT_LIMIT=5000
TXN_MAX_PER_WINDOW=5
TXN_WINDOW_MINUTES=10
